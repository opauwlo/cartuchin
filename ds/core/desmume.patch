   if (desiredSize > 0) {
     savFile->truncate(desiredSize);
     savFile->fseek(0, SEEK_SET);
@@ -349,6 +369,60 @@ int emuSetOpt(int k, int v) {
     if (k == 0) {
       CommonSettings.fwConfig.language = v;
     }
+    if (k == 1) {  // 0=nenhuma 1=linear 2=cosseno
+      if (v >= 0 && v <= 2) CommonSettings.spuInterpolationMode = v;
+    }
+    if (k == 2) {  // 1 = mixagem avançada (mais precisa, mais lenta)
+      CommonSettings.spu_advanced = v ? true : false;
+    }
     return 0;
 }
+
+// Define a taxa de saída do áudio (a do AudioContext do navegador).
+void audioSetup(int sampleRate) {
+  // SPU_core aloca o buffer por hline com base em 48 kHz no NDS_Init;
+  // taxas maiores estourariam esse buffer, então limitamos.
+  if (sampleRate < 8000 || sampleRate > 48000) return;
+  setSampleRate(sampleRate);
+  audioRingR = audioRingW = 0;
+}
+
+// Copia até maxFrames amostras estéreo do ring para audioBuffer (getSymbol 6).
+// Retorna quantas foram copiadas.
+int audioDrain(int maxFrames) {
+  u32 avail = audioRingW - audioRingR;
+  if (maxFrames > 16384) maxFrames = 16384;
+  if (avail > (u32)maxFrames) avail = maxFrames;
+  for (u32 i = 0; i < avail; i++) {
+    u32 r = (audioRingR + i) & (AUDIO_RING_FRAMES - 1);
+    audioBuffer[i * 2] = audioRing[r * 2];
+    audioBuffer[i * 2 + 1] = audioRing[r * 2 + 1];
+  }
+  audioRingR += avail;
+  return (int)avail;
+}
+
+// ---- Save state em memória ----
+static EMUFILE_MEMORY *stateFile = NULL;
+int stateSave() {
+  if (stateFile) delete stateFile;
+  stateFile = new EMUFILE_MEMORY();
+  if (!savestate_save(*stateFile, 0)) return -1;
+  return stateFile->size();
+}
+void *stateGetPointer(int desiredSize) {
+  if (desiredSize > 0) {
+    if (stateFile) delete stateFile;
+    stateFile = new EMUFILE_MEMORY();
+    stateFile->truncate(desiredSize);
+  }
+  return stateFile ? stateFile->buf() : NULL;
+}
+int stateLoad() {
+  if (!stateFile) return -1;
+  stateFile->fseek(0, SEEK_SET);
+  bool ok = savestate_load(*stateFile);
+  audioRingR = audioRingW = 0;
+  return ok ? 0 : -1;
+}
 }
diff --git a/desmume/wasm-port/stubs.cpp b/desmume/wasm-port/stubs.cpp
new file mode 100644
index 0000000..be6ff52
--- /dev/null
+++ b/desmume/wasm-port/stubs.cpp
@@ -0,0 +1,21 @@
+// Funções que o port removeu dos fontes originais e que o core ainda chama.
+// O microfone real fica em main.cpp (Mic_ReadSample com FIFO vindo do JS).
+#include "types.h"
+#include "emufile.h"
+#include "utils/decrypt/header.h"
+
+BOOL Mic_Init(void) { return TRUE; }
+void Mic_DeInit(void) {}
+void Mic_Reset(void) {}
+void mic_savestate(EMUFILE &os) { os.write_32LE(-1); }
+bool mic_loadstate(EMUFILE &is, int size) { is.fseek(size, SEEK_CUR); return true; }
+
+// Secure area: ROMs já decriptadas (o caso comum) passam direto.
+// Decriptar exigiria as chaves da BIOS, que não vão no repositório.
+extern int emuLastError;
+bool DecryptSecureArea(u8 *romheader, u8 *secure) {
+  int romType = DetectRomType(*(Header *)romheader, (char *)secure);
+  if (romType == ROMTYPE_INVALID) return false;
+  if (romType == ROMTYPE_ENCRSECURE) { emuLastError = -1001; return false; }
+  return true;
+}

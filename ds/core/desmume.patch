+// ---- Ring buffer de áudio (versão melhorada) ----
+// O core gera ~sampleRate/59.83 amostras por frame. Em vez de passar pelo
+// sincronizador "N" (que estica/corta amostras e causa estalos quando o
+// frame atrasa), guardamos as amostras cruas aqui. O JS drena após cada
+// frame e o AudioWorklet faz o ajuste fino de taxa (dynamic rate control).
+#define AUDIO_RING_FRAMES 32768  // potência de 2
+static s16 audioRing[AUDIO_RING_FRAMES * 2];
+static u32 audioRingW = 0, audioRingR = 0;
 void SNDWasmFetchSamples(s16 *sampleBuffer, size_t sampleCount,
                          ESynchMode synchMode,
                          ISynchronizingAudioBuffer *theSynchronizer) {
-  if (synchMode == ESynchMode_Synchronous) {
-    theSynchronizer->enqueue_samples(sampleBuffer, sampleCount);
+  for (size_t i = 0; i < sampleCount; i++) {
+    u32 w = audioRingW & (AUDIO_RING_FRAMES - 1);
+    audioRing[w * 2] = sampleBuffer[i * 2];
+    audioRing[w * 2 + 1] = sampleBuffer[i * 2 + 1];
+    audioRingW++;
   }
+  // se o JS parar de drenar, descarta o mais antigo
+  if (audioRingW - audioRingR > AUDIO_RING_FRAMES)
+    audioRingR = audioRingW - AUDIO_RING_FRAMES;
 }
 

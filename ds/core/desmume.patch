 void *savGetPointer(int desiredSize) {
+  // -1 = jogo novo sem save: zera o save do jogo anterior
+  if (desiredSize < 0) {
+    savFile->truncate(0);
+    savFile->fseek(0, SEEK_SET);
+    savFile->changed = 0;

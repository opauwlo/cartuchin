+	bool thumb;
+	std::vector<JitInstr> ins;
+};
+
+template<int P>
+u32 arm_jit_run_ir(uintptr_t handle)
+{
+	const IRBlock *b = (const IRBlock *)handle;
+	armcpu_t *const c = P ? &NDS_ARM7 : &NDS_ARM9;
+	const u32 size = b->thumb ? 2 : 4;
+	u32 total = 0;
+	for (size_t i = 0; i < b->ins.size(); i++)
+	{
+		const JitInstr &in = b->ins[i];
+		c->instruct_adr = in.adr;
+		c->next_instruction = in.adr + size;
+		c->R[15] = in.adr + size * 2;
+		if (in.condMask && !(arm_cond_table[((c->CPSR.val >> 24) & 0xF0) | in.cond] & in.condMask))
+		{
+			total += 1;
+			continue;
+		}
+		total += in.fn(in.opcode);
+	}
+	c->instruct_adr = c->next_instruction;
+	return total;
+}
+template u32 arm_jit_run_ir<0>(uintptr_t);
+template u32 arm_jit_run_ir<1>(uintptr_t);

+static uintptr_t finish_block(u32 start_adr)
+{
+	IRBlock *b = new IRBlock;   // nunca liberado: só para testes
+	b->proc = PROCNUM;
+	b->thumb = bb_thumb;
+	b->ins = s_block;
+	return (uintptr_t)b;
+}

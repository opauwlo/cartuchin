+static void init_jit_mem()
+{
+	static bool inited = false;
+	if (inited) return;
+	inited = true;
+	for (int proc = 0; proc < 2; proc++)
+		for (int i = 0; i < 0x4000; i++)
+			JIT.JIT_MEM[proc][i] = JIT_MEM_MAP[proc][i>>9] ? JIT_MEM_MAP[proc][i>>9] + (((i<<14) & JIT_MASK[proc][i>>9]) >> 1) : NULL;
+}

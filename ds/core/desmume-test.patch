+		case 0x06: { const u32 r = (op >> 8) & 7; e.ldTo(r, L_A); e.k(op & 0xFF); e.set(L_B); e.add(); e.st(r, L_R); e.nzcvAdd(); return 1; }   // ADD imm8
+		case 0x07: { const u32 r = (op >> 8) & 7; e.ldTo(r, L_A); e.k(op & 0xFF); e.set(L_B); e.sub(); e.st(r, L_R); e.nzcvSub(); return 1; }   // SUB imm8
+		case 0x08: {

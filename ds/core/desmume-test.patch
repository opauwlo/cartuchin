+// ---------------------------------------------------------------- gerador de wasm
+
+class WasmOut
+{
+public:
+	std::vector<u8> b;
+	void u8_(u8 v) { b.push_back(v); }
+	void uleb(u32 v) { do { u8 x = v & 0x7F; v >>= 7; if (v) x |= 0x80; b.push_back(x); } while (v); }
+	void sleb(s32 v)
+	{
+		bool more = true;
+		while (more)
+		{
+			u8 x = v & 0x7F;
+			v >>= 7;
+			if ((v == 0 && !(x & 0x40)) || (v == -1 && (x & 0x40))) more = false; else x |= 0x80;
+			b.push_back(x);
+		}
+	}
+	void i32c(u32 v) { u8_(0x41); sleb((s32)v); }
+	void lget(u32 i) { u8_(0x20); uleb(i); }
+	void lset(u32 i) { u8_(0x21); uleb(i); }
+	void store32(u32 off) { u8_(0x36); uleb(2); uleb(off); }
+	void load32(u32 off) { u8_(0x28); uleb(2); uleb(off); }
+	void load8u(u32 off) { u8_(0x2D); uleb(0); uleb(off); }
+	void append(const WasmOut &o) { b.insert(b.end(), o.b.begin(), o.b.end()); }
+	void section(u8 id, const WasmOut &body) { u8_(id); uleb((u32)body.b.size()); append(body); }
+	void name(const char *s) { uleb((u32)strlen(s)); while (*s) u8_((u8)*s++); }
+};
+
+/* ---- Fase B: instruções comuns direto em wasm, sem chamar o interpretador ----
+   Mesma semântica das funções de thumb_instructions.cpp / arm_instructions.cpp (flags,
+   casos especiais e ciclos = 1). Tudo que envolve R15, memória, multiplicação, deslocamento
+   por registrador ou troca de modo continua indo para o interpretador.
+   Locais: 0 = base da CPU, 1 = ciclos, 2 = a, 3 = b, 4 = resultado, 5 = carry. */
+enum { L_BASE = 0, L_CYC = 1, L_A = 2, L_B = 3, L_R = 4, L_C = 5 };
+#define W_AND 0x71
+#define W_OR 0x72
+#define W_XOR 0x73
+#define W_SHL 0x74
+#define W_SHRS 0x75
+#define W_SHRU 0x76
+#define W_ADD 0x6A
+#define W_SUB 0x6B
+#define W_EQZ 0x45
+#define W_LTU 0x49
+#define W_GEU 0x4F
+
+/* Fase C: dentro do bloco, os registradores ficam em locais do wasm (L_REG0 + r). Só vão
+   para a memória (cpu->R) antes de chamar o interpretador, antes de uma instrução
+   condicional e no fim do bloco; depois de uma chamada ao interpretador são relidos. R15
+   nunca fica em local. */
+struct RegCache { bool on; bool loaded[16]; bool dirty[16]; };
+static RegCache s_rc;
+int jitRegCache = 1;
+#define L_REG0 9
+static void rc_reset() { for (int r = 0; r < 16; r++) s_rc.loaded[r] = s_rc.dirty[r] = false; }
+// grava na memória os registradores alterados (estado do cache continua igual)
+static void rc_store_dirty(WasmOut &o, const RegCache &rc)
+{
+	if (!rc.on) return;
+	for (u32 r = 0; r < 15; r++) if (rc.dirty[r]) { o.lget(0); o.lget(L_REG0 + r); o.store32(offsetof(armcpu_t, R) + 4 * r); }
+}
+static void rc_flush(WasmOut &o) { rc_store_dirty(o, s_rc); for (int r = 0; r < 16; r++) s_rc.dirty[r] = false; }
+
+struct Emit
+{
+	WasmOut &o;
+	u32 oR, oCPSR;
+	Emit(WasmOut &out) : o(out), oR(offsetof(armcpu_t, R)), oCPSR(offsetof(armcpu_t, CPSR)) {}
+	// garante R[r] no local (lido da memória uma vez por bloco)
+	void ensure(u32 r) { if (s_rc.on && r != 15 && !s_rc.loaded[r]) { o.lget(L_BASE); o.load32(oR + 4 * r); o.lset(L_REG0 + r); s_rc.loaded[r] = true; } }
+	void ld(u32 r) { if (s_rc.on && r != 15) { ensure(r); o.lget(L_REG0 + r); } else { o.lget(L_BASE); o.load32(oR + 4 * r); } }   // empilha R[r]
+	void ldTo(u32 r, u32 l) { ld(r); o.lset(l); }
+	void st(u32 r, u32 l)   // R[r] = local
+	{
+		if (s_rc.on && r != 15) { o.lget(l); o.lset(L_REG0 + r); s_rc.loaded[r] = s_rc.dirty[r] = true; }
+		else { o.lget(L_BASE); o.lget(l); o.store32(oR + 4 * r); }
+	}
+	void op(u8 x) { o.u8_(x); }
+	void k(u32 v) { o.i32c(v); }
+	void get(u32 l) { o.lget(l); }
+	void set(u32 l) { o.lset(l); }
+	void cpsr() { o.lget(L_BASE); o.load32(oCPSR); }
+	// CPSR = (CPSR & keep) | N | Z | [C<<29] | [V<<28]; c/v são emitidos pelos chamadores
+	void flagsBegin(u32 keep) { o.lget(L_BASE); cpsr(); k(keep); op(W_AND); get(L_R); k(0x80000000); op(W_AND); op(W_OR); get(L_R); op(W_EQZ); k(30); op(W_SHL); op(W_OR); }
+	void flagsEnd() { o.store32(oCPSR); }
+	void nz() { flagsBegin(0x3FFFFFFF); flagsEnd(); }
+	void nzc() { flagsBegin(0x1FFFFFFF); get(L_C); k(29); op(W_SHL); op(W_OR); flagsEnd(); }
+	// a + b = r: C = r <u a; V = ((a ^ r) & (b ^ r)) >> 31
+	void nzcvAdd() { flagsBegin(0x0FFFFFFF); get(L_R); get(L_A); op(W_LTU); k(29); op(W_SHL); op(W_OR);
+		get(L_A); get(L_R); op(W_XOR); get(L_B); get(L_R); op(W_XOR); op(W_AND); k(31); op(W_SHRU); k(28); op(W_SHL); op(W_OR); flagsEnd(); }
+	// a - b = r: C = a >=u b; V = ((a ^ b) & (a ^ r)) >> 31
+	void nzcvSub() { flagsBegin(0x0FFFFFFF); get(L_A); get(L_B); op(W_GEU); k(29); op(W_SHL); op(W_OR);
+		get(L_A); get(L_B); op(W_XOR); get(L_A); get(L_R); op(W_XOR); op(W_AND); k(31); op(W_SHRU); k(28); op(W_SHL); op(W_OR); flagsEnd(); }
+	void add() { get(L_A); get(L_B); op(W_ADD); set(L_R); }
+	void sub() { get(L_A); get(L_B); op(W_SUB); set(L_R); }
+	void carryOld() { cpsr(); k(29); op(W_SHRU); k(1); op(W_AND); set(L_C); }
+};
+
+/* ---- Fase B2: leitura e escrita de memória direto em wasm ----
+   Caminho rápido para a RAM principal (0x02xxxxxx) e, no ARM9, a DTCM — o mesmo que
+   _MMU_read/_MMU_write fazem antes de tudo. Qualquer outro endereço chama a função do
+   interpretador (registradores de I/O, VRAM etc. têm efeitos). Ciclos: os mesmos de
+   MMU_aluMemAccessCycles (sem ADVANCED_TIMING só dependem da região do endereço), por
+   tabela tirada das próprias funções de timing. Escrita na RAM principal apaga a entrada
+   do mapa de blocos, como o MMU faz (código que se reescreve). */
+enum { L_ADR = 6, L_V = 7, L_M = 8, N_LOCALS = 9 + 16 };
+#define W_EQ 0x46
+#define W_NE 0x47
+#define W_GTU 0x4B
+#define W_ROTR 0x78
+#define W_SELECT 0x1B
+struct JitMem { u32 dtcmRegion, dtcm, main, mask8, mask16, mask32, jitMain, cyc; };
+static JitMem s_mem;
+u8 jit_cycTab[2][3][16];   // [processador][8/16/32 bits][região = endereço >> 24]
+template<int P> static void fill_cyc()
+{
+	for (u32 r = 0; r < 16; r++)
+	{
+		jit_cycTab[P][0][r] = (u8)MMU_memAccessCycles<P, 8, MMU_AD_READ>(r << 24);
+		jit_cycTab[P][1][r] = (u8)MMU_memAccessCycles<P, 16, MMU_AD_READ>(r << 24);
+		jit_cycTab[P][2][r] = (u8)MMU_memAccessCycles<P, 32, MMU_AD_READ>(r << 24);
+	}
+}
+static void jit_mem_real()
+{
+	fill_cyc<0>(); fill_cyc<1>();
+	s_mem.dtcmRegion = (u32)(uintptr_t)&MMU.DTCMRegion;
+	s_mem.dtcm = (u32)(uintptr_t)MMU.ARM9_DTCM;
+	s_mem.main = (u32)(uintptr_t)MMU.MAIN_MEM;
+	s_mem.mask8 = (u32)(uintptr_t)&_MMU_MAIN_MEM_MASK;
+	s_mem.mask16 = (u32)(uintptr_t)&_MMU_MAIN_MEM_MASK16;
+	s_mem.mask32 = (u32)(uintptr_t)&_MMU_MAIN_MEM_MASK32;
+	s_mem.jitMain = (u32)(uintptr_t)JIT.MAIN_MEM;
+	s_mem.cyc = (u32)(uintptr_t)jit_cycTab;
+}
+
+// chamada da função do interpretador para uma instrução (ciclos somados no local 1)
+static void emit_call(WasmOut &body, const JitInstr &in, u32 size)
+{
+	body.lget(0); body.i32c(in.adr); body.store32(offsetof(armcpu_t, instruct_adr));
+	body.lget(0); body.i32c(in.adr + size); body.store32(offsetof(armcpu_t, next_instruction));
+	body.lget(0); body.i32c(in.adr + size * 2); body.store32(offsetof(armcpu_t, R) + 15 * 4);
+	body.lget(1);
+	body.i32c(in.opcode);
+	body.i32c((u32)(uintptr_t)in.fn);
+	body.u8_(0x11); body.uleb(1); body.uleb(0);
+	body.u8_(0x6A); body.lset(1);
+}
+
+/* Acesso com o endereço já em L_ADR. sz: 0 = 8, 1 = 16, 2 = 32 bits. rot: LDR de palavra
+   gira pelo desalinhamento. cycConst: o interpretador calcula os ciclos com o endereço já
+   trocado por (adr&3)*8 (região 0) — repetido aqui do jeito que ele faz. */
+static void emit_mem(WasmOut &o, const JitInstr &in, int sz, bool load, u32 rd, bool sgn, bool rot, u32 alu, bool cycConst, u32 isize)
+{
+	Emit e(o);
+	const int P = PROCNUM;
+	const u32 dmask = sz == 2 ? 0x3FFC : sz == 1 ? 0x3FFE : 0x3FFF;
+	const u32 maskAdr = sz == 2 ? s_mem.mask32 : sz == 1 ? s_mem.mask16 : s_mem.mask8;
+	auto access = [&]() {   // ponteiro já na pilha
+		if (load)
+		{
+			if (sz == 2) o.load32(0);
+			else if (sz == 1) { o.u8_(sgn ? 0x2E : 0x2F); o.uleb(1); o.uleb(0); }
+			else { o.u8_(sgn ? 0x2C : 0x2D); o.uleb(0); o.uleb(0); }
+			e.set(L_V);
+		}
+		else
+		{
+			e.ld(rd);
+			if (sz == 2) o.store32(0);
+			else if (sz == 1) { o.u8_(0x3B); o.uleb(1); o.uleb(0); }
+			else { o.u8_(0x3A); o.uleb(0); o.uleb(0); }
+		}
+	};
+	auto tail = [&]() {
+		if (load)
+		{
+			if (rot) { e.get(L_V); e.get(L_ADR); e.k(3); e.op(W_AND); e.k(3); e.op(W_SHL); e.op(W_ROTR); e.set(L_V); }
+			e.st(rd, L_V);
+		}
+		if (cycConst) e.k(P == 0 ? (alu > 1 ? alu : 1) : alu + 1);
+		else
+		{
+			e.get(L_ADR); e.k(24); e.op(W_SHRU); e.k(15); e.op(W_AND);
+			o.load8u(s_mem.cyc + (u32)(P * 3 + sz) * 16); e.set(L_M);
+			if (P == 0) { e.get(L_M); e.k(alu); e.get(L_M); e.k(alu); e.op(W_GTU); e.op(W_SELECT); }
+			else { e.get(L_M); e.k(alu); e.op(W_ADD); }
+		}
+		e.get(L_CYC); e.op(W_ADD); e.set(L_CYC);
+	};
+	if (!load) e.ensure(rd);            // valor a gravar já no local antes dos caminhos
+	const RegCache before = s_rc;       // o caminho lento grava o que estava alterado antes
+	o.u8_(0x02); o.u8_(0x40);          // block: fim
+	o.u8_(0x02); o.u8_(0x40);          // block: caminho lento
+	if (P == 0)
+	{
+		e.get(L_ADR); e.k(~0x3FFFu); e.op(W_AND); e.k(s_mem.dtcmRegion); o.load32(0); e.op(W_EQ);
+		o.u8_(0x04); o.u8_(0x40);
+		e.get(L_ADR); e.k(dmask); e.op(W_AND); e.k(s_mem.dtcm); e.op(W_ADD);
+		access(); tail();
+		o.u8_(0x0C); o.uleb(2);
+		o.u8_(0x0B);
+	}
+	e.get(L_ADR); e.k(0x0F000000); e.op(W_AND); e.k(0x02000000); e.op(W_NE);
+	o.u8_(0x0D); o.uleb(0);
+	e.get(L_ADR); e.k(maskAdr); o.load32(0); e.op(W_AND); e.k(s_mem.main); e.op(W_ADD);
+	access();
+	if (!load)
+	{
+		// mapa de blocos: entrada (endereço & máscara) >> 1, como JIT_COMPILED_FUNC_KNOWNBANK
+		e.get(L_ADR); e.k(maskAdr); o.load32(0); e.op(W_AND); e.k(1); e.op(W_SHRU); e.k(2); e.op(W_SHL); e.k(s_mem.jitMain); e.op(W_ADD);
+		if (sz == 2) { o.u8_(0x42); o.u8_(0x00); o.u8_(0x37); o.uleb(2); o.uleb(0); }   // i64.store 0: as duas entradas da palavra
+		else { e.k(0); o.store32(0); }
+	}
+	tail();
+	o.u8_(0x0C); o.uleb(1);
+	o.u8_(0x0B);
+	rc_store_dirty(o, before);
+	emit_call(o, in, isize);
+	if (load && s_rc.on) { o.lget(L_BASE); o.load32(offsetof(armcpu_t, R) + 4 * rd); o.lset(L_REG0 + rd); }   // o interpretador gravou Rd na memória
+	o.u8_(0x0B);
+	if (load && s_rc.on) s_rc.loaded[rd] = s_rc.dirty[rd] = true;
+}
+
+static int emit_inline_thumb(WasmOut &out, const JitInstr &in)
+{
+	Emit e(out);
+	const u32 op = in.opcode;
+	const u32 rd = op & 7, rs = (op >> 3) & 7;
+	switch (op >> 11)
+	{
+		case 0x00: {   // LSL Rd, Rs, #n
+			const u32 n = (op >> 6) & 31;
+			if (n == 0) { e.ldTo(rs, L_R); e.st(rd, L_R); e.nz(); return 1; }
+			e.ldTo(rs, L_A);
+			e.get(L_A); e.k(32 - n); e.op(W_SHRU); e.k(1); e.op(W_AND); e.set(L_C);
+			e.get(L_A); e.k(n); e.op(W_SHL); e.set(L_R);
+			e.st(rd, L_R); e.nzc(); return 1;
+		}
+		case 0x01: {   // LSR Rd, Rs, #n (0 = 32)
+			const u32 n = (op >> 6) & 31;
+			e.ldTo(rs, L_A);
+			if (n == 0) { e.get(L_A); e.k(31); e.op(W_SHRU); e.set(L_C); e.k(0); e.set(L_R); }
+			else { e.get(L_A); e.k(n - 1); e.op(W_SHRU); e.k(1); e.op(W_AND); e.set(L_C); e.get(L_A); e.k(n); e.op(W_SHRU); e.set(L_R); }

+static int emit_inline_arm(WasmOut &out, const JitInstr &in)
+{
+	Emit e(out);
+	const u32 op = in.opcode;
+	if ((op & 0x0F200000) == 0x05000000)
+	{
+		// fase B2: LDR/STR/LDRB/STRB [Rn, #±imm], sem writeback
+		const u32 rn = (op >> 16) & 15, rd = (op >> 12) & 15, imm = op & 0xFFF;
+		const bool L = (op >> 20) & 1, B = (op >> 22) & 1, U = (op >> 23) & 1;
+		if (rd == 15) return 0;
+		if (rn == 15) e.k(U ? in.adr + 8 + imm : in.adr + 8 - imm);
+		else { e.ld(rn); e.k(imm); e.op(U ? W_ADD : W_SUB); }
+		e.set(L_ADR);
+		emit_mem(out, in, B ? 0 : 2, L, rd, false, L && !B, L ? 3 : 2, false, 4);
+		return 2;
+	}
+	if (((op >> 26) & 3) != 0) return 0;
+	const bool I = (op >> 25) & 1, S = (op >> 20) & 1;
+	if (!I && (op & 0x10)) return 0;               // deslocamento por registrador / multiplicação / LDRH...
+	const u32 opc = (op >> 21) & 15, rn = (op >> 16) & 15, rd = (op >> 12) & 15, rm = op & 15;
+	const bool isCmp = opc >= 8 && opc <= 11;
+	if (isCmp && !S) return 0;                     // MRS/MSR/BX etc.
+	if (opc == 5 || opc == 6 || opc == 7) return 0; // ADC/SBC/RSC
+	const bool usesRn = opc != 13 && opc != 15;
+	if ((!isCmp && rd == 15) || (usesRn && rn == 15) || (!I && rm == 15)) return 0;
+	const bool logical = (opc == 0 || opc == 1 || opc == 8 || opc == 9 || opc == 12 || opc == 13 || opc == 14 || opc == 15);
+	
+	// operando 2 em L_B; carry do deslocador em L_C (só para lógicas com S)
+	const bool needC = logical && S;
+	if (I)
+	{
+		const u32 rot = (op >> 7) & 0x1E, v = ROR((op & 0xFF), rot);
+		e.k(v); e.set(L_B);
+		if (needC) { if ((op >> 8) & 0xF) { e.k(v >> 31); e.set(L_C); } else e.carryOld(); }
+	}
+	else
+	{
+		const u32 type = (op >> 5) & 3, n = (op >> 7) & 31;
+		e.ldTo(rm, L_A);   // L_A é reaproveitado para Rn logo depois
+		if (type == 0)
+		{
+			if (n == 0) { e.get(L_A); e.set(L_B); if (needC) e.carryOld(); }
+			else { if (needC) { e.get(L_A); e.k(32 - n); e.op(W_SHRU); e.k(1); e.op(W_AND); e.set(L_C); } e.get(L_A); e.k(n); e.op(W_SHL); e.set(L_B); }
+		}
+		else if (type == 1)
+		{
+			if (n == 0) { if (needC) { e.get(L_A); e.k(31); e.op(W_SHRU); e.set(L_C); } e.k(0); e.set(L_B); }
+			else { if (needC) { e.get(L_A); e.k(n - 1); e.op(W_SHRU); e.k(1); e.op(W_AND); e.set(L_C); } e.get(L_A); e.k(n); e.op(W_SHRU); e.set(L_B); }
+		}
+		else if (type == 2)
+		{
+			if (n == 0) { if (needC) { e.get(L_A); e.k(31); e.op(W_SHRU); e.set(L_C); } e.get(L_A); e.k(31); e.op(W_SHRS); e.set(L_B); }
+			else { if (needC) { e.get(L_A); e.k(n - 1); e.op(W_SHRU); e.k(1); e.op(W_AND); e.set(L_C); } e.get(L_A); e.k(n); e.op(W_SHRS); e.set(L_B); }
+		}
+		else return 0;   // ROR/RRX: interpretador
+	}
+	if (usesRn) e.ldTo(rn, L_A);
+	
+	switch (opc)
+	{
+		case 0x0: e.get(L_A); e.get(L_B); e.op(W_AND); e.set(L_R); break;
+		case 0x1: e.get(L_A); e.get(L_B); e.op(W_XOR); e.set(L_R); break;
+		case 0x2: e.sub(); break;
+		case 0x3: { // RSB: r = b - a; flags como SUB(b, a)
+			e.get(L_B); e.get(L_A); e.op(W_SUB); e.set(L_R);
+			if (S) { e.get(L_A); e.get(L_B); e.set(L_A); e.set(L_B); }   // troca a/b para nzcvSub
+			break;
+		}
+		case 0x4: e.add(); break;
+		case 0x8: e.get(L_A); e.get(L_B); e.op(W_AND); e.set(L_R); break;
+		case 0x9: e.get(L_A); e.get(L_B); e.op(W_XOR); e.set(L_R); break;
+		case 0xA: e.sub(); break;
+		case 0xB: e.add(); break;
+		case 0xC: e.get(L_A); e.get(L_B); e.op(W_OR); e.set(L_R); break;
+		case 0xD: e.get(L_B); e.set(L_R); break;
+		case 0xE: e.get(L_A); e.get(L_B); e.k(0xFFFFFFFF); e.op(W_XOR); e.op(W_AND); e.set(L_R); break;
+		case 0xF: e.get(L_B); e.k(0xFFFFFFFF); e.op(W_XOR); e.set(L_R); break;
+		default: return 0;
+	}
+	if (!isCmp) e.st(rd, L_R);
+	if (S)
+	{
+		if (logical) e.nzc();
+		else if (opc == 0x4 || opc == 0xB) e.nzcvAdd();
+		else e.nzcvSub();
+	}
+	return 1;
+}
+
+// corpo da função de um bloco (local 0 = base da CPU, local 1 = ciclos)
+static void emit_block_body(WasmOut &body, u32 base, u32 condTab, const std::vector<JitInstr> &blk, bool thumb)
+{
+	const u32 oInstr = offsetof(armcpu_t, instruct_adr);
+	const u32 oNext = offsetof(armcpu_t, next_instruction);
+	const u32 oR15 = offsetof(armcpu_t, R) + 15 * 4;
+	const u32 oFlags = offsetof(armcpu_t, CPSR) + 3;
+	const u32 size = thumb ? 2 : 4;
+	
+	body.uleb(1); body.uleb(N_LOCALS); body.u8_(0x7F);
+	body.i32c(base); body.lset(0);
+	body.i32c(0); body.lset(1);
+	s_rc.on = jitRegCache != 0;
+	rc_reset();
+	bool lastInline = false;
+	for (size_t i = 0; i < blk.size(); i++)
+	{
+		const JitInstr &in = blk[i];
+		// fase B: instrução comum direto em wasm (incondicional ou dentro do teste de condição)
+		{
+			WasmOut tmp;
+			const RegCache saved = s_rc;
+			const bool cacheOn = s_rc.on;
+			if (in.condMask) { rc_flush(body); rc_reset(); s_rc.on = false; }   // condicional: direto na memória
+			const int kind = s_inlineOn ? (thumb ? emit_inline_thumb(tmp, in) : emit_inline_arm(tmp, in)) : 0;
+			s_rc.on = cacheOn;
+			if (!kind && !in.condMask) s_rc = saved;   // tentativa descartada não muda o cache
+			if (kind)
+			{
+				if (in.condMask)
+				{
+					body.lget(0); body.load8u(oFlags);
+					body.i32c(0xF0); body.u8_(0x71);
+					body.i32c(in.cond); body.u8_(0x72);
+					body.load8u(condTab);
+					body.i32c(in.condMask); body.u8_(0x71);
+					body.u8_(0x04); body.u8_(0x40);
+					body.append(tmp);
+					if (kind == 1) { body.lget(1); body.i32c(1); body.u8_(0x6A); body.lset(1); }   // memória (2) soma os próprios ciclos
+					body.u8_(0x05);
+					body.lget(1); body.i32c(1); body.u8_(0x6A); body.lset(1);
+					body.u8_(0x0B);
+				}
+				else
+				{
+					body.append(tmp);
+					if (kind == 1) { body.lget(1); body.i32c(1); body.u8_(0x6A); body.lset(1); }
+				}
+				lastInline = (i + 1 == blk.size());
+				continue;
+			}
+		}
+		// interpretador: lê e grava cpu->R direto
+		rc_flush(body);
+		rc_reset();
+		body.lget(0); body.i32c(in.adr); body.store32(oInstr);
+		body.lget(0); body.i32c(in.adr + size); body.store32(oNext);
+		body.lget(0); body.i32c(in.adr + size * 2); body.store32(oR15);
+		if (in.condMask)
+		{
+			body.lget(0); body.load8u(oFlags);
+			body.i32c(0xF0); body.u8_(0x71);
+			body.i32c(in.cond); body.u8_(0x72);
+			body.load8u(condTab);
+			body.i32c(in.condMask); body.u8_(0x71);
+			body.u8_(0x04); body.u8_(0x40);
+		}
+		body.lget(1);
+		body.i32c(in.opcode);
+		body.i32c((u32)(uintptr_t)in.fn);
+		body.u8_(0x11); body.uleb(1); body.uleb(0);
+		body.u8_(0x6A); body.lset(1);
+		if (in.condMask)
+		{
+			body.u8_(0x05);
+			body.lget(1); body.i32c(1); body.u8_(0x6A); body.lset(1);
+			body.u8_(0x0B);
+		}
+	}
+	rc_flush(body);
+	if (lastInline)
+	{
+		// a última instrução não passou pelo interpretador: o próximo endereço é sequencial
+		const u32 nextAdr = blk.back().adr + size;
+		body.lget(0); body.i32c(nextAdr); body.store32(oNext);
+		body.lget(0); body.i32c(nextAdr); body.store32(oInstr);
+	}
+	else
+	{
+		body.lget(0); body.lget(0); body.load32(oNext); body.store32(oInstr);
+	}
+	body.lget(1);
+	body.u8_(0x0B);
+}
+
+/* Compilação em lotes, fora do caminho do jogo: os blocos quentes entram numa fila; no fim
+   de cada quadro (ou com 128 na fila) vira UM módulo com todas as funções, compilado de
+   forma assíncrona pelo navegador. Quando fica pronto, o JS põe as funções na tabela e
+   grava o índice no mapa — só se a entrada ainda tiver a marca de "na fila" e a geração
+   não mudou (código reescrito ou JIT reiniciado no meio do caminho = descarta). */
+#ifdef __EMSCRIPTEN__
+struct PendingBlock
+{
+	std::vector<u8> body;
+	u32 slot;     // endereço da entrada no mapa de blocos
+	u32 marker;   // valor que a entrada tem enquanto espera (função do interpretador)
+};
+static std::vector<PendingBlock> s_pending;
+static u32 s_generation = 1;
+static u32 s_compiledBlocks = 0;
+
+EM_JS(void, jit_compile_batch, (const u8 *p, int n, const u32 *slots, const u32 *markers, int count, const u32 *genPtr, u32 gen), {
+	var bytes = HEAPU8.slice(p, p + n);
+	var sl = HEAPU32.slice(slots >> 2, (slots >> 2) + count);
+	var mk = HEAPU32.slice(markers >> 2, (markers >> 2) + count);
+	var mem = typeof wasmMemory != "undefined" ? wasmMemory : wasmExports["memory"];
+	var tab = typeof wasmTable != "undefined" ? wasmTable : wasmExports["__indirect_function_table"];
+	Module.jitPending = (Module.jitPending || 0) + 1;
+	WebAssembly.instantiate(bytes, { e: { m: mem, t: tab } }).then(function (r) {
+		Module.jitPending--;
+		if (HEAPU32[genPtr >> 2] !== gen) return;
+		var ex = r.instance.exports, base = tab.grow(count);
+		for (var i = 0; i < count; i++) {
+			tab.set(base + i, ex["f" + i]);
+			if (HEAPU32[sl[i] >> 2] === mk[i]) HEAPU32[sl[i] >> 2] = base + i;
+		}
+		Module.jitBlocks = (Module.jitBlocks || 0) + count;
+	}, function (e) {
+		Module.jitPending--;
+		Module.jitErrors = (Module.jitErrors || 0) + 1;
+		if (Module.jitErrors < 3) console.warn("[jit] lote não compilou", e);
+	});
+});
+
+void arm_jit_flush()
+{
+	if (s_pending.empty()) return;
+	const size_t n = s_pending.size();
+	WasmOut m;
+	const u8 hdr[8] = { 0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00 };
+	m.b.insert(m.b.end(), hdr, hdr + 8);
+	WasmOut s;
+	s.uleb(2);
+	s.u8_(0x60); s.uleb(0); s.uleb(1); s.u8_(0x7F);
+	s.u8_(0x60); s.uleb(1); s.u8_(0x7F); s.uleb(1); s.u8_(0x7F);
+	m.section(1, s);
+	s.b.clear();
+	s.uleb(2);
+	s.name("e"); s.name("m"); s.u8_(0x02); s.u8_(0x00); s.uleb(1);
+	s.name("e"); s.name("t"); s.u8_(0x01); s.u8_(0x70); s.u8_(0x00); s.uleb(1);
+	m.section(2, s);
+	s.b.clear(); s.uleb((u32)n); for (size_t i = 0; i < n; i++) s.uleb(0); m.section(3, s);
+	s.b.clear(); s.uleb((u32)n);
+	for (size_t i = 0; i < n; i++)
+	{
+		char nm[16];
+		snprintf(nm, sizeof(nm), "f%u", (unsigned)i);
+		s.name(nm); s.u8_(0x00); s.uleb((u32)i);
+	}
+	m.section(7, s);
+	s.b.clear(); s.uleb((u32)n);
+	std::vector<u32> slots(n), markers(n);
+	for (size_t i = 0; i < n; i++)
+	{
+		s.uleb((u32)s_pending[i].body.size());
+		s.b.insert(s.b.end(), s_pending[i].body.begin(), s_pending[i].body.end());
+		slots[i] = s_pending[i].slot;
+		markers[i] = s_pending[i].marker;
+	}
+	m.section(10, s);
+	s_pending.clear();
+	s_compiledBlocks += (u32)n;
+	jit_compile_batch(m.b.data(), (int)m.b.size(), slots.data(), markers.data(), (int)n, &s_generation, s_generation);
+}
+#else
+void arm_jit_flush() {}
+#endif
+
+// ---------------------------------------------------------------- compilação
+
+// quantas vezes um trecho de 16 bytes roda no interpretador antes de virar bloco compilado
+#define JIT_HOT_THRESHOLD 16
+static u8 hot_counts[(1<<26)/16];
+
+template<int P>
+static void build_block(armcpu_t *c, u32 start_adr)
+{
+	const u32 size = bb_thumb ? 2 : 4;
+	u32 maxInstr = CommonSettings.jit_max_block_size;
+	if (maxInstr > 64) maxInstr = 64;
+	if (maxInstr < 1) maxInstr = 1;
+	s_block.clear();
+	for (u32 i = 0, end = 0; !end; i++)
+	{
+		const u32 adr = start_adr + i * size;
+		const u32 opcode = bb_thumb ? _MMU_read16<P, MMU_AT_CODE>(adr) : _MMU_read32<P, MMU_AT_CODE>(adr);
+		end = instr_is_branch(opcode) || (i >= maxInstr - 1);
+		JitInstr in;
+		in.adr = adr;
+		in.opcode = opcode;
+		if (bb_thumb)
+		{
+			in.fn = thumb_instructions_set[P][opcode>>6];
+			in.condMask = 0;
+			in.cond = 0;
+		}
+		else
+		{
+			in.fn = arm_instructions_set[P][INSTRUCTION_INDEX(opcode)];
+			in.cond = (u8)CONDITION(opcode);
+			in.condMask = (in.cond == 0xE) ? 0 : (u8)(1 << CODE(opcode));
+		}
+		s_block.push_back(in);
+	}
+}
+
+template<int P>
+static u32 compile_basicblock()
+{
+	armcpu_t *const c = P ? &NDS_ARM7 : &NDS_ARM9;
+	const u32 start_adr = c->instruct_adr;
+	bb_thumb = c->CPSR.bits.T;
+	
+	if (!JIT_MAPPED(start_adr & 0x0FFFFFFF, P))
+		return op_decode[P][bb_thumb]();
+	
+	// trecho frio: só interpreta (código de inicialização roda uma vez e não vale compilar)
+	const u32 h = (start_adr & 0x07FFFFFE) >> 4;
+	if (hot_counts[h] < JIT_HOT_THRESHOLD)
+	{
+		hot_counts[h]++;
+		return op_decode[P][bb_thumb]();
+	}
+	
+	build_block<P>(c, start_adr);
+	uintptr_t &slot = JIT_COMPILED_FUNC(start_adr, P);
+#ifdef __EMSCRIPTEN__
+	// fila para o próximo lote; até lá, a entrada aponta para o interpretador (a "marca")
+	PendingBlock pb;
+	WasmOut body;
+	emit_block_body(body, (u32)(uintptr_t)c, (u32)(uintptr_t)arm_cond_table, s_block, bb_thumb);
+	pb.body.swap(body.b);
+	pb.marker = (u32)(uintptr_t)op_decode[P][bb_thumb];
+	pb.slot = (u32)(uintptr_t)&slot;
+	slot = pb.marker;
+	s_pending.push_back(pb);
+	if (s_pending.size() >= 128) arm_jit_flush();
+#else
+	slot = finish_block(start_adr);
+#endif
+	return op_decode[P][bb_thumb]();
+}
+
+template<int P> u32 arm_jit_compile()
+{
+	PROCNUM = P;
+	armcpu_t *const c = P ? &NDS_ARM7 : &NDS_ARM9;
+	
+	// código que se reescreve sem parar: depois de 8 recompilações no mesmo trecho, só interpreta
+	const u32 adr = c->instruct_adr;
+	const u32 mask_adr = (adr & 0x07FFFFFE) >> 4;
+	if (((recompile_counts[mask_adr >> 1] >> 4*(mask_adr & 1)) & 0xF) > 8)
+		return op_decode[P][c->CPSR.bits.T]();
+	
+	const u32 h = (adr & 0x07FFFFFE) >> 4;
+	if (hot_counts[h] >= JIT_HOT_THRESHOLD)
+		recompile_counts[mask_adr >> 1] += 1 << 4*(mask_adr & 1);
+	
+	return compile_basicblock<P>();
+}
+
+template u32 arm_jit_compile<0>();
+template u32 arm_jit_compile<1>();
+
+void arm_jit_reset(bool enable, bool suppress_msg)
+{
+	if (!suppress_msg)
+		printf("CPU: %s\n", enable ? "JIT (wasm)" : "interpretador");
+	saveBlockSizeJIT = CommonSettings.jit_max_block_size;
+
+	if (enable)
+	{
+		init_jit_mem();
+		jit_mem_real();
+		// os blocos antigos ficam na tabela de funções (não dá para liberar), mas saem do mapa
+		memset(JIT.MAIN_MEM, 0, sizeof(JIT.MAIN_MEM));
+		memset(JIT.SWIRAM, 0, sizeof(JIT.SWIRAM));
+		memset(JIT.ARM9_ITCM, 0, sizeof(JIT.ARM9_ITCM));
+		memset(JIT.ARM9_LCDC, 0, sizeof(JIT.ARM9_LCDC));
+		memset(JIT.ARM9_BIOS, 0, sizeof(JIT.ARM9_BIOS));
+		memset(JIT.ARM7_BIOS, 0, sizeof(JIT.ARM7_BIOS));
+		memset(JIT.ARM7_ERAM, 0, sizeof(JIT.ARM7_ERAM));
+		memset(JIT.ARM7_WIRAM, 0, sizeof(JIT.ARM7_WIRAM));
+		memset(JIT.ARM7_WRAM, 0, sizeof(JIT.ARM7_WRAM));
+		memset(recompile_counts, 0, sizeof(recompile_counts));
+		memset(hot_counts, 0, sizeof(hot_counts));
+#ifdef __EMSCRIPTEN__
+		s_pending.clear();
+		s_generation++;   // lotes ainda compilando são descartados
+#endif
+	}
+}
+
+void arm_jit_close()
+{
+}
+
+#ifdef JIT_FUZZ
+#include <random>
+/* Teste diferencial da fase B (só nativo): para instruções que viram wasm direto, roda o
+   interpretador nativo com registradores e flags aleatórios e grava, para cada caso, o
+   módulo wasm de 1 instrução + estado de entrada + estado esperado. O tools/jit-fuzz.cjs
+   executa os módulos no Node e compara. */
+static void wrap_module(WasmOut &m, const WasmOut &body)
+{
+	const u8 hdr[8] = { 0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00 };
+	m.b.insert(m.b.end(), hdr, hdr + 8);
+	WasmOut s;
+	s.uleb(2);
+	s.u8_(0x60); s.uleb(0); s.uleb(1); s.u8_(0x7F);
+	s.u8_(0x60); s.uleb(1); s.u8_(0x7F); s.uleb(1); s.u8_(0x7F);
+	m.section(1, s);
+	s.b.clear(); s.uleb(2);
+	s.name("e"); s.name("m"); s.u8_(0x02); s.u8_(0x00); s.uleb(1);
+	s.name("e"); s.name("t"); s.u8_(0x01); s.u8_(0x70); s.u8_(0x00); s.uleb(1);
+	m.section(2, s);
+	s.b.clear(); s.uleb(1); s.uleb(0); m.section(3, s);
+	s.b.clear(); s.uleb(1); s.name("f0"); s.u8_(0x00); s.uleb(0); m.section(7, s);
+	s.b.clear(); s.uleb(1); s.uleb((u32)body.b.size()); s.append(body); m.section(10, s);
+}
+
+/* endereço efetivo das instruções de memória que a fase B2 emite (para o fuzz mirar nas
+   janelas de memória que o teste reproduz no Node) */
+static bool fuzz_ea(const JitInstr &in, const u32 *R, bool thumb, u32 &ea, int &sz, bool &store)
+{
+	const u32 op = in.opcode;
+	if (thumb)
+	{
+		const u32 rs = (op >> 3) & 7;
+		switch (op >> 11)
+		{
+			case 0x09: ea = ((in.adr + 4) & ~3u) + ((op & 0xFF) << 2); sz = 2; store = false; return true;
+			case 0x0A: case 0x0B: { static const int SZ[8] = { 2, 1, 0, 0, 2, 1, 0, 1 }; const u32 sub = (op >> 9) & 7; ea = R[rs] + R[(op >> 6) & 7]; sz = SZ[sub]; store = sub < 3; return true; }
+			case 0x0C: case 0x0D: ea = R[rs] + ((op >> 4) & 0x7C); sz = 2; store = !((op >> 11) & 1); return true;
+			case 0x0E: case 0x0F: ea = R[rs] + ((op >> 6) & 0x1F); sz = 0; store = !((op >> 11) & 1); return true;
+			case 0x10: case 0x11: ea = R[rs] + ((op >> 5) & 0x3E); sz = 1; store = !((op >> 11) & 1); return true;
+			case 0x12: case 0x13: ea = R[13] + ((op & 0xFF) << 2); sz = 2; store = !((op >> 11) & 1); return true;
+			default: return false;
+		}
+	}
+	if ((op & 0x0F200000) != 0x05000000) return false;
+	const u32 rn = (op >> 16) & 15, imm = op & 0xFFF;
+	const u32 b = rn == 15 ? in.adr + 8 : R[rn];
+	ea = ((op >> 23) & 1) ? b + imm : b - imm;
+	sz = ((op >> 22) & 1) ? 0 : 2;
+	store = !((op >> 20) & 1);
+	return true;
+}
+
+int jit_fuzz_dump(const char *path, int count)
+{
+	FILE *f = fopen(path, "w");
+	if (!f) return -1;
+	std::mt19937 rng(1234);
+	const u32 BASE = 4096, CONDTAB = 1024;
+	// memória falsa no Node: janela de 128 KB da RAM principal e a DTCM
+	const u32 WIN = 0x20000, DTCM_REG = 0x027C0000;
+	fill_cyc<0>(); fill_cyc<1>();
+	s_mem.cyc = 2048; s_mem.dtcmRegion = 2200; s_mem.mask8 = 2204; s_mem.mask16 = 2208; s_mem.mask32 = 2212;
+	s_mem.dtcm = 0x10000; s_mem.main = 0x20000; s_mem.jitMain = 0x40000;
+	MMU.DTCMRegion = DTCM_REG;
+	for (u32 i = 0; i < WIN; i++) MMU.MAIN_MEM[i] = (u8)rng();
+	for (u32 i = 0; i < 0x4000; i++) MMU.ARM9_DTCM[i] = (u8)rng();
+	std::vector<u8> snapMain(MMU.MAIN_MEM, MMU.MAIN_MEM + WIN), snapDtcm(MMU.ARM9_DTCM, MMU.ARM9_DTCM + 0x4000);
+	fprintf(f, "{\"oR\":%u,\"oC\":%u,\"base\":%u,\"condTab\":%u,", (u32)offsetof(armcpu_t, R), (u32)offsetof(armcpu_t, CPSR), BASE, CONDTAB);
+	fprintf(f, "\"lay\":{\"cyc\":%u,\"dtcmRegion\":%u,\"mask8\":%u,\"mask16\":%u,\"mask32\":%u,\"dtcm\":%u,\"main\":%u,\"jitMain\":%u},", s_mem.cyc, s_mem.dtcmRegion, s_mem.mask8, s_mem.mask16, s_mem.mask32, s_mem.dtcm, s_mem.main, s_mem.jitMain);
+	fprintf(f, "\"dtcmReg\":%u,\"masks\":[%u,%u,%u],\"cycTab\":[", DTCM_REG, WIN - 1, (WIN - 1) & ~1u, (WIN - 1) & ~3u);
+	for (int i = 0; i < 96; i++) fprintf(f, "%s%u", i ? "," : "", ((u8 *)jit_cycTab)[i]);
+	fprintf(f, "],\"mainHex\":\"");
+	for (u32 i = 0; i < WIN; i++) fprintf(f, "%02x", snapMain[i]);
+	fprintf(f, "\",\"dtcmHex\":\"");
+	for (u32 i = 0; i < 0x4000; i++) fprintf(f, "%02x", snapDtcm[i]);
+	fprintf(f, "\",\"cond\":[");
+	for (int i = 0; i < 256; i++) fprintf(f, "%s%u", i ? "," : "", arm_cond_table[i]);
+	fprintf(f, "],\"t\":[\n");
+	int made = 0, mems = 0;
+	// casos de 1 a 4 instruções no mesmo bloco (o cache de registradores atravessa instruções)
+	for (long tries = 0; made < count && tries < (long)count * 400; tries++)
+	{
+		const int P = (rng() % 3 == 0) ? 1 : 0;
+		PROCNUM = P;
+		armcpu_t *const c = P ? &NDS_ARM7 : &NDS_ARM9;
+		const bool thumb = rng() & 1;
+		const int n = 1 + (made % 4 == 0 ? 0 : (int)(rng() % 4));
+		const u32 adr0 = 0x02000000 + (rng() & 0xFFF0);
+		std::vector<JitInstr> blk;
+		bool anyMem = false;
+		for (int k = 0; k < n; k++)
+		{
+			JitInstr in;
+			int kind = 0;
+			for (int t = 0; t < 200 && !kind; t++)
+			{
+				in.adr = adr0 + k * (thumb ? 2 : 4);
+				u32 op = rng();
+				if (thumb) op &= 0xFFFF;
+				else if ((rng() & 3) != 0) op = (op & 0x0FFFFFFF) | 0xE0000000;
+				if (rng() & 1)
+				{
+					if (thumb) { static const u32 HI[] = { 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10, 0x11, 0x12, 0x13 }; op = (op & 0x7FF) | (HI[rng() % 11] << 11); }
+					else op = (op & 0xF0DFFFFF) | 0x05000000;
+				}
+				in.opcode = op;
+				if (thumb) { in.fn = thumb_instructions_set[P][op >> 6]; in.condMask = 0; in.cond = 0; }
+				else { in.fn = arm_instructions_set[P][INSTRUCTION_INDEX(op)]; in.cond = (u8)CONDITION(op); in.condMask = (in.cond == 0xE) ? 0 : (u8)(1 << CODE(op)); }
+				WasmOut probe;
+				s_rc.on = false; rc_reset();
+				kind = thumb ? emit_inline_thumb(probe, in) : emit_inline_arm(probe, in);
+			}
+			if (!kind) break;
+			anyMem |= kind == 2;
+			blk.push_back(in);
+		}
+		if ((int)blk.size() != n) continue;
+		
+		u32 regs[16];
+		for (int r = 0; r < 16; r++)
+		{
+			u32 v = rng();
+			if (anyMem)
+			{
+				const u32 k = rng() % 20;
+				if (k < 8) v = 0x02000000 + (v & (WIN - 1));
+				else if (k < 13 && P == 0) v = DTCM_REG + (v & 0x3FFF);
+				else v &= 0x3FF;
+			}
+			else switch (rng() % 5) { case 0: v &= 0xFF; break; case 1: v |= 0x80000000; break; case 2: v = 0; break; default: break; }
+			regs[r] = v;
+		}
+		const u32 cpsr = (rng() & 0xF0000000) | 0x1F | (thumb ? 0x20 : 0);
+		for (int r = 0; r < 16; r++) c->R[r] = regs[r];
+		c->CPSR.val = cpsr;
+		// executa no interpretador, instrução por instrução; registra os acessos à memória
+		struct Touch { bool dt; u32 from; int sz; u32 ea; bool st; };
+		std::vector<Touch> touches;
+		bool ok = true;
+		u32 cyc = 0;
+		for (size_t k = 0; k < blk.size() && ok; k++)
+		{
+			const JitInstr &in = blk[k];
+			c->R[15] = in.adr + (thumb ? 4 : 8);
+			c->instruct_adr = in.adr;
+			c->next_instruction = in.adr + (thumb ? 2 : 4);
+			const bool skipped = in.condMask && !(arm_cond_table[((c->CPSR.val >> 24) & 0xF0) | in.cond] & in.condMask);
+			u32 ea = 0; int sz = 0; bool store = false;
+			if (fuzz_ea(in, c->R, thumb, ea, sz, store) && !skipped)
+			{
+				const bool inDtcm = P == 0 && (ea & ~0x3FFFu) == DTCM_REG;
+				const bool inMain = !inDtcm && (ea & 0x0F000000) == 0x02000000 && (ea & 0x00FFFFFF) < WIN;
+				const u32 off = inDtcm ? (ea & 0x3FFF) : (ea & (WIN - 1)), lim = inDtcm ? 0x4000 : WIN;
+				if ((!inDtcm && !inMain) || off < 8 || off + 12 > lim) { ok = false; break; }
+				touches.push_back({ inDtcm, (off & ~3u) - 8, sz, ea, store });
+			}
+			cyc += skipped ? 1 : in.fn(in.opcode);
+		}
+		c->instruct_adr = c->next_instruction;
+		auto restore = [&]() {
+			for (const Touch &t : touches)
+			{
+				u8 *mem = t.dt ? MMU.ARM9_DTCM : MMU.MAIN_MEM;
+				const std::vector<u8> &snap = t.dt ? snapDtcm : snapMain;
+				for (u32 i = 0; i < 20; i++) mem[t.from + i] = snap[t.from + i];
+			}
+		};
+		if (!ok) { restore(); continue; }
+		regs[15] = blk[0].adr + (thumb ? 4 : 8);
+		
+		WasmOut body, m;
+		emit_block_body(body, BASE, CONDTAB, blk, thumb);
+		wrap_module(m, body);
+		fprintf(f, "%s{\"op\":%u,\"n\":%d,\"p\":%d,\"thumb\":%d,\"m\":\"", made ? ",\n" : "", blk[0].opcode, (int)blk.size(), P, thumb ? 1 : 0);
+		for (size_t i = 0; i < m.b.size(); i++) fprintf(f, "%02x", m.b[i]);
+		fprintf(f, "\",\"in\":[");
+		for (int r = 0; r < 16; r++) fprintf(f, "%s%u", r ? "," : "", regs[r]);
+		fprintf(f, "],\"cpsr\":%u,\"out\":[", cpsr);
+		for (int r = 0; r < 16; r++) fprintf(f, "%s%u", r ? "," : "", c->R[r]);
+		fprintf(f, "],\"ocpsr\":%u,\"cyc\":%u,\"next\":%u,\"mem\":[", c->CPSR.val, cyc, c->next_instruction);
+		for (size_t k = 0; k < touches.size(); k++)
+		{
+			const Touch &t = touches[k];
+			u8 *mem = t.dt ? MMU.ARM9_DTCM : MMU.MAIN_MEM;
+			fprintf(f, "%s{\"ea\":%u,\"sz\":%d,\"st\":%d,\"dt\":%d,\"from\":%u,\"bytes\":\"", k ? "," : "", t.ea, t.sz, t.st ? 1 : 0, t.dt ? 1 : 0, t.from);
+			for (u32 i = 0; i < 20; i++) fprintf(f, "%02x", mem[t.from + i]);
+			fprintf(f, "\"}");
+		}
+		fprintf(f, "]}");
+		restore();
+		mems += touches.empty() ? 0 : 1;
+		made++;
+	}
+	fprintf(f, "\n]}\n");
+	fclose(f);
+	fprintf(stderr, "casos de memória: %d\n", mems);
+	return made;
+}
+

+static u32 JIT_MASK[2][32] = {
+	{
+		DUP2(0x00007FFF), DUP2(0x00007FFF), DUP2(0x003FFFFF), DUP2(0x00007FFF),
+		DUP2(0x00000000), DUP2(0x00000000), 0x00000000, 0x000FFFFF, DUP2(0x00000000),
+		DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000),
+		DUP2(0x00007FFF)
+	},
+	{
+		DUP2(0x00003FFF), DUP2(0x00000000), DUP2(0x003FFFFF), 0x00007FFF, 0x0000FFFF,
+		0x00000000, 0x0000FFFF, DUP2(0x00000000), 0x0003FFFF, 0x00000000, DUP2(0x00000000),
+		DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000), DUP2(0x00000000),

+// ---------------------------------------------------------------- atributos das instruções
+
+static int PROCNUM;            // processador do bloco em compilação (o ARMPROC usa este nome)
+#define cpu (&ARMPROC)
+static bool bb_thumb;
+
+static u32 instr_attributes(u32 opcode)
+{
+	return bb_thumb ? thumb_attributes[opcode>>6] : instruction_attributes[INSTRUCTION_INDEX(opcode)];
+}
+
+static bool instr_is_branch(u32 opcode)
+{
+	u32 x = instr_attributes(opcode);
+	if (bb_thumb)
+	{
+		if (x & MERGE_NEXT) return false;   // BL em duas metades: fica no mesmo bloco
+		return (x & BRANCH_ALWAYS)
+			|| ((x & BRANCH_POS0) && ((opcode&7) | ((opcode>>4)&8)) == 15)
+			|| (x & BRANCH_SWI)
+			|| (x & JIT_BYPASS);
+	}
+	return (x & BRANCH_ALWAYS)
+		|| ((x & BRANCH_POS12) && REG_POS(opcode,12) == 15)
+		|| ((x & BRANCH_LDM) && BIT15(opcode))
+		|| (x & BRANCH_SWI)
+		|| (x & JIT_BYPASS);
+}
+
+// ---------------------------------------------------------------- execução de uma instrução (primeira passada)
+
+template<int P, int thumb>
+static u32 FASTCALL OP_DECODE()
+{
+	armcpu_t *const c = P ? &NDS_ARM7 : &NDS_ARM9;
+	u32 cycles;
+	const u32 adr = c->instruct_adr;
+	if (thumb)
+	{
+		c->next_instruction = adr + 2;
+		c->R[15] = adr + 4;
+		const u32 opcode = _MMU_read16<P, MMU_AT_CODE>(adr);
+		cycles = thumb_instructions_set[P][opcode>>6](opcode);
+	}
+	else
+	{
+		c->next_instruction = adr + 4;
+		c->R[15] = adr + 8;
+		const u32 opcode = _MMU_read32<P, MMU_AT_CODE>(adr);
+		if (CONDITION(opcode) == 0xE || TEST_COND(CONDITION(opcode), CODE(opcode), c->CPSR))
+			cycles = arm_instructions_set[P][INSTRUCTION_INDEX(opcode)](opcode);
+		else
+			cycles = 1;
+	}
+	c->instruct_adr = c->next_instruction;
+	return cycles;
+}
+
+static const ArmOpCompiled op_decode[2][2] = { OP_DECODE<0,0>, OP_DECODE<0,1>, OP_DECODE<1,0>, OP_DECODE<1,1> };

new file mode 100644
index 00000000..2a31eeac
--- /dev/null
+++ b/desmume/src/GLES3Render.cpp
@@ -0,0 +1,1200 @@
+/*
+	Renderizador 3D em GPU (OpenGL ES 3.0 / WebGL2). Ver GLES3Render.h.
+
+	Cores no framebuffer: RGBA8 com cor PRÉ-MULTIPLICADA pelo alfa. Assim a regra do DS
+	"se o destino tem alfa 0, o translúcido substitui" sai de graça da mistura
+	(ONE, ONE_MINUS_SRC_ALPHA) e o alfa usa MAX, como no hardware.
+	Atributos: cor 1 R = ID do polígono opaco, B = polígono translúcido; cor 2 = profundidade
+	de 24 bits do DS (RGB); cor 3 = névoa. Alfa guardado como peso do DS ((a+1)/32).
+	Stencil: bits 0-5 = ID do último translúcido, bit 6 = ID válido, bit 7 = sombra.
+	Profundidade: gl_FragDepth = profundidade de 24 bits do DS (z ou w), exata.
+*/
+
+#include "GLES3Render.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <vector>
+#include <algorithm>
+
+using std::min;
+using std::max;
+
+#include "GPU.h"
+#include "NDSSystem.h"
+#include "utils/colorspacehandler/colorspacehandler.h"
+
+#ifdef __EMSCRIPTEN__
+	#include <emscripten.h>
+	#include <emscripten/html5.h>
+	#include <GLES3/gl3.h>
+#else
+	#include <EGL/egl.h>
+	#include <EGL/eglext.h>
+	#include <GLES3/gl3.h>
+#endif
+
+// ---------------------------------------------------------------- contexto
+
+// 1 = aceita WebGL por software (só para testes: emuSetOpt(4, 3))
+int gles3AllowSlowGL = 0;
+// 1 = o 3D lido em RenderFinish é o do quadro anterior: a GPU trabalha enquanto o core
+// emula o quadro seguinte, sem travar esperando (emuSetOpt(5, 1)). 0 = mesmo quadro.
+int gles3FrameLag = 1;
+
+#ifdef __EMSCRIPTEN__
+static EMSCRIPTEN_WEBGL_CONTEXT_HANDLE s_ctx = 0;
+
+static bool GLES3_MakeContext()
+{
+	if (s_ctx > 0)
+	{
+		return emscripten_webgl_make_context_current(s_ctx) == EMSCRIPTEN_RESULT_SUCCESS;
+	}
+
+	const int hasDoc = EM_ASM_INT({
+		if (typeof document === 'undefined' || !document.body) return 0;
+		var c = document.getElementById('ds-gl3d');
+		if (!c) {
+			c = document.createElement('canvas');
+			c.id = 'ds-gl3d'; c.width = 1; c.height = 1;
+			c.style.cssText = 'position:fixed;width:1px;height:1px;left:-10px;top:-10px;pointer-events:none;opacity:0';
+			document.body.appendChild(c);
+		}
+		return 1;
+	});
+	if (!hasDoc) return false;
+
+	EmscriptenWebGLContextAttributes a;
+	emscripten_webgl_init_context_attributes(&a);
+	a.majorVersion = 2;
+	a.minorVersion = 0;
+	a.alpha = 0;
+	a.depth = 0;
+	a.stencil = 0;
+	a.antialias = 0;
+	a.premultipliedAlpha = 0;
+	a.preserveDrawingBuffer = 0;
+	a.powerPreference = EM_WEBGL_POWER_PREFERENCE_HIGH_PERFORMANCE;
+	a.failIfMajorPerformanceCaveat = gles3AllowSlowGL ? 0 : 1;   // WebGL por software seria mais lento que o nosso rasterizador
+
+	s_ctx = emscripten_webgl_create_context("#ds-gl3d", &a);
+	if (s_ctx <= 0)
+	{
+		s_ctx = 0;
+		return false;
+	}
+	return emscripten_webgl_make_context_current(s_ctx) == EMSCRIPTEN_RESULT_SUCCESS;
+}
+#else
+static EGLDisplay s_dpy = EGL_NO_DISPLAY;
+static EGLContext s_ctx = EGL_NO_CONTEXT;
+
+static bool GLES3_MakeContext()
+{
+	if (s_ctx != EGL_NO_CONTEXT)
+	{
+		return eglMakeCurrent(s_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, s_ctx) == EGL_TRUE;
+	}
+
+	s_dpy = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	if (s_dpy == EGL_NO_DISPLAY || !eglInitialize(s_dpy, NULL, NULL)) return false;
+	eglBindAPI(EGL_OPENGL_ES_API);
+
+	EGLConfig cfg = (EGLConfig)0;
+	EGLint n = 0;
+	const EGLint cfgAttr[] = { EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_NONE };
+	eglChooseConfig(s_dpy, cfgAttr, &cfg, 1, &n);
+	const EGLint ctxAttr[] = { EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 0, EGL_NONE };
+	s_ctx = eglCreateContext(s_dpy, (n > 0) ? cfg : (EGLConfig)0, EGL_NO_CONTEXT, ctxAttr);
+	if (s_ctx == EGL_NO_CONTEXT) return false;
+	return eglMakeCurrent(s_dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, s_ctx) == EGL_TRUE;
+}
+#endif
+
+static void DropFence(GLsync &f);
+static void ReadPBO(GLuint pbo, void *dst, size_t bytes);
+
+// ---------------------------------------------------------------- shaders
+
+static const char *kGeomVS =
+"#version 300 es\n"
+"precision highp float;\n"
+"layout(location=0) in vec4 aPos;\n"   // x,y em pixels do framebuffer (linha 0 = topo do DS), z 0..1, w
+"layout(location=1) in vec2 aTex;\n"   // texels
+"layout(location=2) in vec3 aCol;\n"   // 0..63
+"uniform vec2 uFbSize;\n"
+"out vec2 vTex;\n"
+"out vec3 vCol;\n"
+"void main() {\n"
+"  vec2 ndc = aPos.xy / uFbSize * 2.0 - 1.0;\n"
+"  gl_Position = vec4(ndc * aPos.w, (aPos.z * 2.0 - 1.0) * aPos.w, aPos.w);\n"
+"  vTex = aTex;\n"
+"  vCol = aCol;\n"
+"}\n";
+
+static const char *kGeomFS =
+"#version 300 es\n"
+"precision highp float;\n"
+"precision highp int;\n"
+"precision highp usampler2D;\n"
+"in vec2 vTex;\n"
+"in vec3 vCol;\n"
+"uniform usampler2D uTex;\n"
+"uniform int uTexOn, uWrap, uMode, uAlpha, uHighlight, uAlphaTest, uAlphaRef, uWBuf, uOpaqueSel, uDepthEq, uPolyID, uFog, uIsTrans;\n"
+"uniform ivec2 uTexSize;\n"
+"uniform ivec4 uToon[32];\n"
+"layout(location=0) out vec4 oColor;\n"
+"layout(location=1) out vec4 oAttr;\n"
+"layout(location=2) out vec4 oDepth;\n"
+"layout(location=3) out vec4 oFog;\n"
+"int to6(int x) { return x == 0 ? 0 : x * 2 + 1; }\n"
+"int wrapc(int v, int size, bool rep, bool flip) {\n"
+"  if (!rep) return clamp(v, 0, size - 1);\n"
+"  if (flip) { v &= (size * 2 - 1); if (v >= size) v = size * 2 - v - 1; return v; }\n"
+"  return v & (size - 1);\n"
+"}\n"
+"ivec3 mod3(ivec3 a, ivec3 b) { return ((a + 1) * (b + 1) - 1) >> 6; }\n"
+"void main() {\n"
+"  ivec3 src = clamp(ivec3(floor(vCol + 0.5)), 0, 63);\n"
+"  int sa = uAlpha;\n"
+"  ivec4 t = ivec4(63, 63, 63, 31);\n"
+"  if (uTexOn != 0) {\n"
+"    ivec2 tc = ivec2(floor(vTex));\n"
+"    tc.x = wrapc(tc.x, uTexSize.x, (uWrap & 1) != 0, (uWrap & 4) != 0);\n"
+"    tc.y = wrapc(tc.y, uTexSize.y, (uWrap & 2) != 0, (uWrap & 8) != 0);\n"
+"    t = ivec4(texelFetch(uTex, tc, 0));\n"
+"  }\n"
+"  int ma = (((to6(t.a) + 1) * (to6(sa) + 1) - 1) >> 6) >> 1;\n"
+"  ivec4 d;\n"
+"  if (uMode == 0) d = ivec4(mod3(t.rgb, src), ma);\n"
+"  else if (uMode == 1) d = (uTexOn != 0) ? ivec4((t.rgb * t.a + src * (31 - t.a)) >> 5, sa) : ivec4(src, sa);\n"
+"  else if (uMode == 2) {\n"
+"    ivec3 toon = uToon[src.r >> 1].rgb;\n"
+"    if (uHighlight != 0) d = ivec4(min(mod3(t.rgb, src.rrr) + toon, ivec3(63)), ma);\n"
+"    else d = ivec4(mod3(t.rgb, toon), ma);\n"
+"  }\n"
+"  else d = ivec4(src, sa);\n"
+"  if (d.a == 0 || (uAlphaTest != 0 && d.a < uAlphaRef)) discard;\n"
+"  if (uOpaqueSel == 1 && d.a == 31) discard;\n"
+"  if (uOpaqueSel == 2 && d.a != 31) discard;\n"
+"  int depth = (uWBuf != 0) ? int(min(floor(4096.0 / gl_FragCoord.w), 16777215.0)) : int(floor(gl_FragCoord.z * 4194303.0)) * 4;\n"
+"  if (uDepthEq != 0) depth = max(depth - 255, 0);\n"
+"  depth = clamp(depth, 0, 16777215);\n"
+"  gl_FragDepth = float(depth) / 16777215.0;\n"
+"  oDepth = vec4(float(depth >> 16), float((depth >> 8) & 255), float(depth & 255), 255.0) / 255.0;\n"
+"  float af = (d.a >= 31) ? 1.0 : float(d.a + 1) / 32.0;\n"   // peso do DS: (a+1)/32
+
+"  oColor = vec4(vec3(d.rgb) / 63.0 * af, af);\n"
+"  oAttr = vec4(float(uPolyID) / 63.0, 0.0, float(uIsTrans), 1.0);\n"
+"  oFog = vec4(float(uFog), 0.0, 0.0, 1.0);\n"
+"}\n";
+
+static const char *kFullVS =
+"#version 300 es\n"
+"void main() {\n"
+"  vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+"  gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+"}\n";
+
+// imagem de fundo (CLRIMAGE): cor pré-multiplicada + profundidade|névoa<<24
+static const char *kClearFS =
+"#version 300 es\n"
+"precision highp float;\n"
+"precision highp int;\n"
+"precision highp usampler2D;\n"
+"uniform sampler2D uCC;\n"
+"uniform usampler2D uCD;\n"
+"uniform vec2 uScale;\n"
+"uniform float uClearID;\n"
+"layout(location=0) out vec4 oColor;\n"
+"layout(location=1) out vec4 oAttr;\n"
+"layout(location=2) out vec4 oDepth;\n"
+"layout(location=3) out vec4 oFog;\n"
+"void main() {\n"
+"  ivec2 p = min(ivec2(gl_FragCoord.xy * uScale), ivec2(255, 191));\n"
+"  oColor = texelFetch(uCC, p, 0);\n"
+"  uint d = texelFetch(uCD, p, 0).r;\n"
+"  gl_FragDepth = float(d & 0xFFFFFFu) / 16777215.0;\n"
+"  oDepth = vec4(float((d >> 16) & 255u), float((d >> 8) & 255u), float(d & 255u), 255.0) / 255.0;\n"
+"  oAttr = vec4(uClearID, 0.0, 0.0, 1.0);\n"
+"  oFog = vec4(float(d >> 24), 0.0, 0.0, 1.0);\n"
+"}\n";
+
+// passe final: despré-multiplica, marca bordas, névoa; escreve bytes 6665 exatos
+static const char *kResolveFS =
+"#version 300 es\n"
+"precision highp float;\n"
+"precision highp int;\n"
+"precision highp usampler2D;\n"
+"uniform sampler2D uColor;\n"
+"uniform sampler2D uAttr;\n"
+"uniform sampler2D uDepth;\n"
+"uniform sampler2D uFogF;\n"
+"uniform usampler2D uFogT;\n"
+"uniform int uEdgeOn, uFogOn, uFogAlphaOnly, uClearID, uClearDepth;\n"
+"uniform ivec4 uFogColor;\n"
+"uniform ivec4 uEdge[8];\n"
+"uniform int uStep;\n"   // borda com ~1 pixel do DS em qualquer escala
+
+"out vec4 o;\n"
+"int depthAt(ivec2 p) { ivec3 b = ivec3(floor(texelFetch(uDepth, p, 0).rgb * 255.0 + 0.5)); return (b.r << 16) | (b.g << 8) | b.b; }\n"
+"int idAt(ivec2 p) { return int(floor(texelFetch(uAttr, p, 0).r * 63.0 + 0.5)); }\n"
+"void main() {\n"
+"  ivec2 p = ivec2(gl_FragCoord.xy);\n"
+"  ivec2 sz = textureSize(uColor, 0);\n"
+"  vec4 P = texelFetch(uColor, p, 0);\n"
+"  ivec4 dst = ivec4(0, 0, 0, (P.a <= 0.0) ? 0 : clamp(int(floor(P.a * 32.0 + 0.5)) - 1, 0, 31));\n"
+"  if (P.a > 0.0) dst.rgb = clamp(ivec3(floor(P.rgb / P.a * 63.0 + 0.5)), 0, 63);\n"
+"  if (uEdgeOn != 0 || uFogOn != 0) {\n"
+"    vec4 at = texelFetch(uAttr, p, 0);\n"
+"    int depth = depthAt(p);\n"
+"    if (uEdgeOn != 0 && at.b < 0.5) {\n"
+"      int id = int(floor(at.r * 63.0 + 0.5));\n"
+"      bool clr = (id != uClearID) && (depth < uClearDepth);\n"
+"      ivec2 pr = p + ivec2(uStep, 0), pd = p + ivec2(0, uStep), pl = p - ivec2(uStep, 0), pu = p - ivec2(0, uStep);\n"
+"      bool right = (p.x >= sz.x - uStep) ? clr : (idAt(pr) != id && depth >= depthAt(pr));\n"
+"      bool down  = (p.y >= sz.y - uStep) ? clr : (idAt(pd) != id && depth >= depthAt(pd));\n"
+"      bool left  = (p.x < uStep) ? clr : (idAt(pl) != id && depth >= depthAt(pl));\n"
+"      bool up    = (p.y < uStep) ? clr : (idAt(pu) != id && depth >= depthAt(pu));\n"
+"      ivec4 e = uEdge[id >> 3];\n"
+"      if (right) { if (p.x < sz.x - uStep) e = uEdge[idAt(pr) >> 3]; }\n"
+"      else if (down) { if (p.y < sz.y - uStep) e = uEdge[idAt(pd) >> 3]; }\n"
+"      else if (left) { if (p.x >= uStep) e = uEdge[idAt(pl) >> 3]; }\n"
+"      else if (up) { if (p.y >= uStep) e = uEdge[idAt(pu) >> 3]; }\n"
+"      if (right || down || left || up) {\n"
+"        if (e.a == 31 || dst.a == 0) dst = e;\n"
+"        else { int al = e.a + 1, inv = 32 - al; dst.rgb = (al * e.rgb + inv * dst.rgb) >> 5; dst.a = max(e.a, dst.a); }\n"
+"      }\n"
+"    }\n"
+"    if (uFogOn != 0 && texelFetch(uFogF, p, 0).r > 0.5) {\n"
+"      int fi = depth >> 9;\n"
+"      int fog = int(texelFetch(uFogT, ivec2(fi & 255, fi >> 8), 0).r);\n"
+"      if (uFogAlphaOnly == 0) dst.rgb = ((128 - fog) * dst.rgb + uFogColor.rgb * fog) >> 7;\n"
+"      dst.a = ((128 - fog) * dst.a + uFogColor.a * fog) >> 7;\n"
+"    }\n"
+"  }\n"
+"  o = vec4(dst) / 255.0;\n"
+"}\n";
+
+static GLuint CompileShader(GLenum type, const char *src)
+{
+	GLuint s = glCreateShader(type);
+	glShaderSource(s, 1, &src, NULL);
+	glCompileShader(s);
+	GLint ok = 0;
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok)
+	{
+		char log[2048] = {0};
+		glGetShaderInfoLog(s, sizeof(log) - 1, NULL, log);
+		printf("GLES3: erro no shader: %s\n", log);
+		glDeleteShader(s);
+		return 0;
+	}
+	return s;
+}
+
+static GLuint LinkProgram(const char *vs, const char *fs)
+{
+	GLuint v = CompileShader(GL_VERTEX_SHADER, vs);
+	GLuint f = CompileShader(GL_FRAGMENT_SHADER, fs);
+	if (!v || !f) return 0;
+	GLuint p = glCreateProgram();
+	glAttachShader(p, v);
+	glAttachShader(p, f);
+	glLinkProgram(p);
+	glDeleteShader(v);
+	glDeleteShader(f);
+	GLint ok = 0;
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok)
+	{
+		char log[2048] = {0};
+		glGetProgramInfoLog(p, sizeof(log) - 1, NULL, log);
+		printf("GLES3: erro no link: %s\n", log);
+		glDeleteProgram(p);
+		return 0;
+	}
+	return p;
+}
+
+// ---------------------------------------------------------------- estado GL
+
+struct GLES3Renderer::GLState
+{
+	GLuint progGeom, progClear, progResolve;
+	GLint gFbSize, gTex, gTexOn, gWrap, gMode, gAlpha, gHighlight, gAlphaTest, gAlphaRef, gWBuf, gOpaqueSel, gDepthEq, gPolyID, gFog, gIsTrans, gTexSize, gToon;
+	GLint cCC, cCD, cScale, cClearID;
+	GLint rColor, rAttr, rDepth, rFogT, rEdgeOn, rFogOn, rFogAlphaOnly, rClearID, rClearDepth, rFogColor, rEdge;
+
+	GLuint vao, vbo, ibo, emptyVao;
+	size_t vboCap, iboCap;
+	GLuint fbo, texColor, texAttr, texDepth, texDepthC, texFogF;
+	GLuint fboOut, texOut;
+	GLuint texClrColor, texClrDepth, texFog, texDummy;
+	size_t w, h;
+
+	// leitura assíncrona: dois PBOs alternados, cada um com sua cerca
+	GLuint pbo[2];
+	GLsync fence[2];
+	bool pending[2];
+	int cur;          // próximo PBO a receber um quadro
+	size_t pboBytes;
+
+	std::vector<float> verts;
+	std::vector<GLuint> idx;
+
+	struct Run
+	{
+		size_t poly;     // primeiro polígono do lote
+		size_t first;    // índice inicial no ibo
+		size_t count;
+		bool lines;
+	};
+	std::vector<Run> runs;
+
+	u8 fogTable[32768];
+	GLint clearID;
+	GLint clearDepth;
+
+};
+
+// ---------------------------------------------------------------- texturas
+
+GLES3Texture::GLES3Texture(TEXIMAGE_PARAM texAttributes, u32 palAttributes) : Render3DTexture(texAttributes, palAttributes)
+{
+	texID = 0;
+	unpackBuffer = (u32 *)malloc_alignedCacheLine(this->_sizeS * this->_sizeT * sizeof(u32));
+}
+
+GLES3Texture::~GLES3Texture()
+{
+	if (texID) glDeleteTextures(1, &texID);
+	free_aligned(unpackBuffer);
+}
+
+void GLES3Texture::LoadGL()
+{
+	// 15bpp = cores 6665 (r,g,b 0..63, a 0..31): o shader faz as contas do DS em inteiros
+	this->Unpack<TexFormat_15bpp>(this->unpackBuffer);
+	if (!texID)
+	{
+		glGenTextures(1, &texID);
+		glBindTexture(GL_TEXTURE_2D, texID);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	}
+	else
+	{
+		glBindTexture(GL_TEXTURE_2D, texID);
+	}
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8UI, this->_sizeS, this->_sizeT, 0, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, this->unpackBuffer);
+	this->_isLoadNeeded = false;
+}
+
+// ---------------------------------------------------------------- renderizador
+
+GLES3Renderer::GLES3Renderer()
+{
+	_deviceInfo.renderID = RENDERID_GLES3;
+	_deviceInfo.renderName = "GLES3";
+	_deviceInfo.isTexturingSupported = true;
+	_deviceInfo.isEdgeMarkSupported = true;
+	_deviceInfo.isFogSupported = true;
+	_deviceInfo.isTextureSmoothingSupported = false;
+	_deviceInfo.maxAnisotropy = 1.0f;
+	_deviceInfo.maxSamples = 0;
+
+	_gl = new GLState();   // () zera os campos simples
+	_renderState = NULL;
+	_ready = GLES3_MakeContext() && _InitGL();
+	if (_ready)
+	{
+		// o cache de texturas é compartilhado com o SoftRasterizer: não reaproveitar itens dele
+		texCache.Reset();
+	}
+	else
+	{
+		printf("GLES3: sem contexto WebGL2/GLES3; usando o rasterizador por software\n");
+	}
+}
+
+GLES3Renderer::~GLES3Renderer()
+{
+	if (_ready)
+	{
+		GLES3_MakeContext();
+		texCache.Reset();   // apaga as texturas GL enquanto o contexto existe
+		GLState &g = *_gl;
+		glDeleteProgram(g.progGeom);
+		glDeleteProgram(g.progClear);
+		glDeleteProgram(g.progResolve);
+		DropFence(g.fence[0]);
+		DropFence(g.fence[1]);
+		GLuint bufs[] = { g.vbo, g.ibo, g.pbo[0], g.pbo[1] };
+		glDeleteBuffers(4, bufs);
+		GLuint vaos[] = { g.vao, g.emptyVao };
+		glDeleteVertexArrays(2, vaos);
+		GLuint fbos[] = { g.fbo, g.fboOut };
+		glDeleteFramebuffers(2, fbos);
+		GLuint texs[] = { g.texColor, g.texAttr, g.texDepth, g.texOut, g.texClrColor, g.texClrDepth, g.texFog, g.texDummy, g.texDepthC, g.texFogF };
+		glDeleteTextures(10, texs);
+	}
+	delete _gl;
+}
+
+static GLuint MakeTex(GLenum internalFmt, GLsizei w, GLsizei h, GLenum fmt, GLenum type, const void *data)
+{
+	GLuint t;
+	glGenTextures(1, &t);
+	glBindTexture(GL_TEXTURE_2D, t);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glTexImage2D(GL_TEXTURE_2D, 0, internalFmt, w, h, 0, fmt, type, data);
+	return t;
+}
+
+bool GLES3Renderer::_InitGL()
+{
+	GLState &g = *_gl;
+
+	g.progGeom = LinkProgram(kGeomVS, kGeomFS);
+	g.progClear = LinkProgram(kFullVS, kClearFS);
+	g.progResolve = LinkProgram(kFullVS, kResolveFS);
+	if (!g.progGeom || !g.progClear || !g.progResolve) return false;
+
+	GLuint p = g.progGeom;
+	g.gFbSize = glGetUniformLocation(p, "uFbSize");
+	g.gTex = glGetUniformLocation(p, "uTex");
+	g.gTexOn = glGetUniformLocation(p, "uTexOn");
+	g.gWrap = glGetUniformLocation(p, "uWrap");
+	g.gMode = glGetUniformLocation(p, "uMode");
+	g.gAlpha = glGetUniformLocation(p, "uAlpha");
+	g.gHighlight = glGetUniformLocation(p, "uHighlight");
+	g.gAlphaTest = glGetUniformLocation(p, "uAlphaTest");
+	g.gAlphaRef = glGetUniformLocation(p, "uAlphaRef");
+	g.gWBuf = glGetUniformLocation(p, "uWBuf");
+	g.gOpaqueSel = glGetUniformLocation(p, "uOpaqueSel");
+	g.gDepthEq = glGetUniformLocation(p, "uDepthEq");
+	g.gPolyID = glGetUniformLocation(p, "uPolyID");
+	g.gFog = glGetUniformLocation(p, "uFog");
+	g.gIsTrans = glGetUniformLocation(p, "uIsTrans");
+	g.gTexSize = glGetUniformLocation(p, "uTexSize");
+	g.gToon = glGetUniformLocation(p, "uToon");
+
+	p = g.progClear;
+	g.cCC = glGetUniformLocation(p, "uCC");
+	g.cCD = glGetUniformLocation(p, "uCD");
+	g.cScale = glGetUniformLocation(p, "uScale");
+	g.cClearID = glGetUniformLocation(p, "uClearID");
+
+	p = g.progResolve;
+	g.rColor = glGetUniformLocation(p, "uColor");
+	g.rAttr = glGetUniformLocation(p, "uAttr");
+	g.rDepth = glGetUniformLocation(p, "uDepth");
+	g.rFogT = glGetUniformLocation(p, "uFogT");
+	g.rEdgeOn = glGetUniformLocation(p, "uEdgeOn");
+	g.rFogOn = glGetUniformLocation(p, "uFogOn");
+	g.rFogAlphaOnly = glGetUniformLocation(p, "uFogAlphaOnly");
+	g.rClearID = glGetUniformLocation(p, "uClearID");
+	g.rClearDepth = glGetUniformLocation(p, "uClearDepth");
+	g.rFogColor = glGetUniformLocation(p, "uFogColor");
+	g.rEdge = glGetUniformLocation(p, "uEdge");
+
+	glGenVertexArrays(1, &g.vao);
+	glGenVertexArrays(1, &g.emptyVao);
+	glGenBuffers(1, &g.vbo);
+	glGenBuffers(1, &g.ibo);
+	glBindVertexArray(g.vao);
+	glBindBuffer(GL_ARRAY_BUFFER, g.vbo);
+	glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, g.ibo);
+	glEnableVertexAttribArray(0);
+	glEnableVertexAttribArray(1);
+	glEnableVertexAttribArray(2);
+	glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, 9 * sizeof(float), (void *)0);
+	glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 9 * sizeof(float), (void *)(4 * sizeof(float)));
+	glVertexAttribPointer(2, 3, GL_FLOAT, GL_FALSE, 9 * sizeof(float), (void *)(6 * sizeof(float)));
+	glBindVertexArray(0);
+
+	const u32 white = 0x1F3F3F3F;
+	g.texDummy = MakeTex(GL_RGBA8UI, 1, 1, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, &white);
+	g.texClrColor = MakeTex(GL_RGBA8, 256, 192, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	g.texClrDepth = MakeTex(GL_R32UI, 256, 192, GL_RED_INTEGER, GL_UNSIGNED_INT, NULL);
+	g.texFog = MakeTex(GL_R8UI, 256, 128, GL_RED_INTEGER, GL_UNSIGNED_BYTE, NULL);
+
+	glGenFramebuffers(1, &g.fbo);
+	glGenFramebuffers(1, &g.fboOut);
+
+	return glGetError() == GL_NO_ERROR;
+}
+
+bool GLES3Renderer::_ResizeTargets(size_t w, size_t h)
+{
+	GLState &g = *_gl;
+	if (g.w == w && g.h == h && g.texColor) return true;
+
+	if (g.texColor)
+	{
+		GLuint texs[] = { g.texColor, g.texAttr, g.texDepth, g.texOut, g.texDepthC, g.texFogF };
+		glDeleteTextures(6, texs);
+	}
+	g.texColor = MakeTex(GL_RGBA8, (GLsizei)w, (GLsizei)h, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	g.texAttr = MakeTex(GL_RGBA8, (GLsizei)w, (GLsizei)h, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	g.texDepth = MakeTex(GL_DEPTH24_STENCIL8, (GLsizei)w, (GLsizei)h, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, NULL);
+	g.texFogF = MakeTex(GL_R8, (GLsizei)w, (GLsizei)h, GL_RED, GL_UNSIGNED_BYTE, NULL);
+	g.texDepthC = MakeTex(GL_RGBA8, (GLsizei)w, (GLsizei)h, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+	g.texOut = MakeTex(GL_RGBA8, (GLsizei)w, (GLsizei)h, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+
+	glBindFramebuffer(GL_FRAMEBUFFER, g.fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g.texColor, 0);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, g.texAttr, 0);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT2, GL_TEXTURE_2D, g.texDepthC, 0);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT3, GL_TEXTURE_2D, g.texFogF, 0);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, g.texDepth, 0);
+	const bool okMain = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+
+	glBindFramebuffer(GL_FRAMEBUFFER, g.fboOut);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g.texOut, 0);
+	const bool okOut = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+	// PBOs do tamanho do quadro; quadros pendentes de outro tamanho são descartados
+	if (!g.pbo[0]) glGenBuffers(2, g.pbo);
+	g.pboBytes = w * h * 4;
+	for (int i = 0; i < 2; i++)
+	{
+		DropFence(g.fence[i]);
+		g.pending[i] = false;
+		glBindBuffer(GL_PIXEL_PACK_BUFFER, g.pbo[i]);
+		glBufferData(GL_PIXEL_PACK_BUFFER, (GLsizeiptr)g.pboBytes, NULL, GL_STREAM_READ);
+	}
+	glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+	g.cur = 0;
+
+	g.w = w;
+	g.h = h;
+	return okMain && okOut;
+}
+
+ClipperMode GLES3Renderer::GetPreferredPolygonClippingMode() const
+{
+	return ClipperMode_Full;
+}

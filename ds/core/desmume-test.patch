+// Define a taxa de saída do áudio (a do AudioContext do navegador).
+void audioSetup(int sampleRate) {
+  // SPU_core aloca o buffer por hline com base em 48 kHz no NDS_Init;
+  // taxas maiores estourariam esse buffer, então limitamos.
+  if (sampleRate < 8000 || sampleRate > 48000) return;
+  setSampleRate(sampleRate);
+  audioRingR = audioRingW = 0;
+}
+
+// Copia até maxFrames amostras estéreo do ring para audioBuffer (getSymbol 6).
+// Retorna quantas foram copiadas.
+int audioDrain(int maxFrames) {
+  u32 avail = audioRingW - audioRingR;
+  if (maxFrames > 16384) maxFrames = 16384;
+  if (avail > (u32)maxFrames) avail = maxFrames;
+  for (u32 i = 0; i < avail; i++) {
+    u32 r = (audioRingR + i) & (AUDIO_RING_FRAMES - 1);
+    audioBuffer[i * 2] = audioRing[r * 2];
+    audioBuffer[i * 2 + 1] = audioRing[r * 2 + 1];
+  }
+  audioRingR += avail;
+  return (int)avail;
+}
+
+// ---- Save state em memória ----
+static EMUFILE_MEMORY *stateFile = NULL;
+int stateSave() {
+  if (stateFile) delete stateFile;
+  stateFile = new EMUFILE_MEMORY();
+  if (!savestate_save(*stateFile, 0)) return -1;
+  return stateFile->size();
+}
+void *stateGetPointer(int desiredSize) {
+  if (desiredSize > 0) {
+    if (stateFile) delete stateFile;
+    stateFile = new EMUFILE_MEMORY();
+    stateFile->truncate(desiredSize);
+  }
+  return stateFile ? stateFile->buf() : NULL;
+}
+int stateLoad() {
+  if (!stateFile) return -1;
+  stateFile->fseek(0, SEEK_SET);
+  bool ok = savestate_load(*stateFile);
+  audioRingR = audioRingW = 0;
+  return ok ? 0 : -1;
+}
 }

diff --git a/desmume/src/arm_jit_wasm.cpp b/desmume/src/arm_jit_wasm.cpp
new file mode 100644
index 00000000..7846ae1a
--- /dev/null
+++ b/desmume/src/arm_jit_wasm.cpp
@@ -0,0 +1,1129 @@
+/*
+	JIT de ARM para WebAssembly (Cartuchin), no lugar do arm_jit.cpp (x86/AsmJit).
+
+	Fase A, "call-threaded": cada bloco básico (do endereço até o primeiro desvio) vira uma
+	função wasm pequena que, para cada instrução, grava instruct_adr/next_instruction/R15
+	como o interpretador faria, testa a condição e chama a MESMA função do interpretador
+	(call_indirect com o opcode como constante). Some a busca na memória, a decodificação
+	e o despacho por instrução; o comportamento é o do interpretador.
+
+	Mesma interface do arm_jit.cpp: o laço do NDSSystem chama armcpu_exec<P,true>(), que
+	usa JIT_COMPILED_FUNC(endereço) (índice na tabela de funções do wasm) ou compila.
+	As escritas em memória já zeram a entrada do endereço escrito (ganchos HAVE_JIT do MMU).
+
+	Fora do navegador (teste nativo, JIT_IR_NATIVE) o bloco é a mesma lista de instruções
+	executada por um laço em C: valida a formação de blocos e a contagem de ciclos.
+*/
+
+#include "types.h"
+
+#ifdef HAVE_JIT
+
+#include <stddef.h>
+#include <string.h>
+#include <stdio.h>
+#include <vector>
+
+#include "utils/bits.h"
+#include "armcpu.h"
+#include "instructions.h"
+#include "instruction_attributes.h"
+#include "MMU.h"
+#include "MMU_timing.h"
+#include "arm_jit.h"
+#include "NDSSystem.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+u32 saveBlockSizeJIT = 0;
+
+// ---------------------------------------------------------------- mapa de blocos (igual ao arm_jit.cpp)
+
+CACHE_ALIGN JIT_struct JIT;
+uintptr_t *JIT_struct::JIT_MEM[2][0x4000] = {{0}};
+
+static uintptr_t *JIT_MEM_MAP[2][32] = {
+	{
+		DUP2(JIT.ARM9_ITCM), DUP2(JIT.ARM9_ITCM), DUP2(JIT.MAIN_MEM), DUP2(JIT.SWIRAM),
+		DUP2(NULL), DUP2(NULL), NULL, JIT.ARM9_LCDC, DUP2(NULL),
+		DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL),
+		DUP2(JIT.ARM9_BIOS)
+	},
+	{
+		DUP2(JIT.ARM7_BIOS), DUP2(NULL), DUP2(JIT.MAIN_MEM), JIT.SWIRAM, JIT.ARM7_ERAM,
+		NULL, JIT.ARM7_WIRAM, DUP2(NULL), JIT.ARM7_WRAM, NULL, DUP2(NULL),
+		DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL), DUP2(NULL),
+		DUP2(NULL)
+	}
+};
